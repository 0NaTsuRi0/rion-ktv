# ============================================
# 骏耀K歌 配置文件
# 复制此文件为 .env 后修改
# ============================================

# 服务端口
PORT=8080

# 数据目录（数据库、封面缓存、HLS 转码缓存）
# 相对路径相对于项目根目录 (rion-ktv/)
DATA_DIR=./data

# MV 曲库目录（放视频文件的地方）
MV_DIR=./songs

# HLS 转码缓存目录
HLS_DIR=./data/hls

# HLS 缓存最长保留天数（超过自动清理）
HLS_CACHE_MAX_AGE_DAYS=3


# ffmpeg / ffprobe 路径（留空使用系统 PATH 中的）
# FFMPEG_PATH=E:\tools\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=E:\tools\ffmpeg\bin\ffprobe.exe

# VAAPI 硬件加速设备路径（Windows 下不可用，忽略）
# VAAPI_DEVICE=/dev/dri/renderD128

# Pymss AI 伴奏分离路径
PYMSS_PYTHON=e:\data\Pymss-Studio-0.0.3-windows-x64-cuda\python-runtime\python.exe
PYMSS_SRC=e:\data\Pymss-Studio-0.0.3-windows-x64-cuda\pymss

# 文件变更监控（MV 目录新增/删除文件时自动扫描）
WATCH_ENABLED=true
WATCH_DEBOUNCE_MS=5000
